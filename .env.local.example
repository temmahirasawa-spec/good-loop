# GOOD LOOP の環境変数のひな形
#
# このファイルは**プレースホルダだけ**を書く場所です。実値は絶対に書かないこと。
# 実値は .env.local に書きます（.gitignore で除外済み・コミットされません）。
# このリポジトリは public です。
#
# 実値は天真が各サービスの管理画面から取得して、
# ローカルの .env.local と Vercel の環境変数に登録します。
# 取得の手順は docs/setup-tasks.md にまとまっています。

# ── Supabase ───────────────────────────────────────────
# GOOD ORDER と同じ組織に作る LOOP 専用プロジェクト（新規作成）。
# 洋輔さんの実動版（jqvyepvjxnkpirusesxg）とは別プロジェクト。混同しないこと。
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# サーバー側だけで使う。ブラウザに渡さない（NEXT_PUBLIC_ を付けない）。
# RLS を飛び越える鍵なので、漏れたら全店舗のデータが読まれる。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Anthropic ──────────────────────────────────────────
# AI クチコミ下書きの生成（docs/specs/rating-flow.md B節・Claude Haiku 4.5）。
# サーバー側だけで使う。NEXT_PUBLIC_ を付けないこと。
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Google Places API ──────────────────────────────────
# 管理画面の店舗編集で、店名から Googleマップ上の店舗を検索して紐付けるために使う
# （Figma: Modal / 店舗編集（Googleマップ紐付け））。サーバー側だけで使う。
GOOGLE_PLACES_API_KEY=your-google-places-key-here

# ── メール送信（Resend） ───────────────────────────────
# 低評価アラート（設定/通知）とパスワードリセットの送信に使う。
# 送信元ドメインの所有確認が要るため、goodloop.jp の取得後に設定する。
RESEND_API_KEY=re_your-key-here

# ── Stripe ─────────────────────────────────────────────
# 設定（お支払い）画面。料金体系の金額が確定してから着手する。
STRIPE_SECRET_KEY=sk_test_your-key-here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your-key-here
STRIPE_WEBHOOK_SECRET=whsec_your-secret-here

# ── Sentry ─────────────────────────────────────────────
# LOOP 専用プロジェクトを新規作成し、Slack の #goodloop_monitoring に接続する。
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn.ingest.sentry.io/your-project-id

# ── Figma ──────────────────────────────────────────────
# npm run design:figma が使う。**リポジトリには置かない。**
# ~/.zshrc に  export FIGMA_TOKEN="figd_..."  と書く。
# 現行トークンの有効期限は 2026-11-01。切れると 403 で落ちる。
# FIGMA_TOKEN=（~/.zshrc に置く。ここには書かない）
