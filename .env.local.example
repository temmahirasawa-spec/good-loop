# GOOD LOOP の環境変数のひな形
#
# このファイルは**プレースホルダだけ**を書く場所です。実値は絶対に書かないこと。
# 実値は .env.local に書きます（.gitignore で除外済み・コミットされません）。
# このリポジトリは public です。
#
# 実値は天真が Supabase / Vercel / Sentry の管理画面から取得して、
# ローカルの .env.local と Vercel の環境変数に登録します。

# ── Supabase ───────────────────────────────────────────
# GOOD ORDER と同じ組織に作る LOOP 専用プロジェクト（新規作成）。
# 洋輔さんの実動版（jqvyepvjxnkpirusesxg）とは別プロジェクト。混同しないこと。
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# サーバー側だけで使う。ブラウザに渡さない（NEXT_PUBLIC_ を付けない）。
# RLS を飛び越える鍵なので、漏れたら全店舗のデータが読まれる。
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Sentry ─────────────────────────────────────────────
# LOOP 専用プロジェクトを新規作成し、Slack の #goodloop_monitoring に接続する。
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn.ingest.sentry.io/your-project-id

# ── Figma ──────────────────────────────────────────────
# npm run design:figma が使う。**リポジトリには置かない。**
# ~/.zshrc に  export FIGMA_TOKEN="figd_..."  と書く。
# 現行トークンの有効期限は 2026-11-01。切れると 403 で落ちる。
# FIGMA_TOKEN=（~/.zshrc に置く。ここには書かない）
