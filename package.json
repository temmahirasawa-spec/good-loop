{
  "name": "good-loop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:check": "NEXT_BUILD_DIR=.next-check next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint --max-warnings 0",
    "check": "npm run typecheck && npm run lint && npm run secrets && npm run tenant && npm run design && npm run build:check",
    "secrets": "node scripts/check-secrets.mjs",
    "tenant": "node scripts/check-tenant.mjs",
    "design": "node scripts/check-design-tokens.mjs",
    "design:figma": "node scripts/check-figma.mjs",
    "design:comments": "node scripts/figma-comments.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "tenant:create": "node --env-file=.env.local scripts/create-tenant.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.1",
    "next": "14.2.35",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "server-only": "^0.0.1",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "playwright": "^1.62.1",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
